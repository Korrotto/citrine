DEFINE MISSING_AS 42
DEFINE 1FORBIDDEN AS 1
DEFINE BAD AS 1+2
DEFINE DUP AS 1
DEFINE DUP AS 2
DEFINE ORPHAN AS PHANTOM
DEFINE LOOP_A AS LOOP_B
DEFINE LOOP_B AS LOOP_A
DEFINE NEVER_USED AS 7

USED
USED no_dot
USED .missing_label

.label_with_instruction: HLT

PSEUDO NOTHING NOP
PSEUDO TST2 TO LDI {0} {1}
PSEUDO LDI TO UDI 0 {0} 1
PSEUDO ZZ TO UDI 0 {0} {1}
PSEUDO ZZ TO UDI 1 {0} {1}
PSEUDO PBAD TO UDI 99 {0} 1
PSEUDO NEVER TO UDI 0 {0} {1}

LDI R1 300
LDI R1
LDI R1 ORPHAN
LDI R1 LOOP_A
LDI R4 DUP
FOO R1 R2
ZZ R3 R4
PBAD R1
HLT
