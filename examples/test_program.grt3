DEFINE DIVIDEND AS R0
DEFINE DIVISOR AS R1
DEFINE QUOTIENT AS R2
DEFINE REMAINDER AS R3

DEFINE N AS 42
DEFINE D AS 4

PSEUDO SUBTRACT TO ARI 2 {0} {0} {1}
PSEUDO RESTORE TO ARI 0 {0} {0} {1}

USED .main

.main:
    LDI DIVIDEND N
    LDI DIVISOR D
    CAL .divide

    OUT 0 QUOTIENT
    OUT 1 REMAINDER
    HLT

.divide:
    LDI QUOTIENT ZERO
    MOV REMAINDER DIVIDEND
.loop:
    SUBTRACT REMAINDER DIVISOR
    BRH LESS .undo
    INC QUOTIENT
    JMP .loop
.undo:
    RESTORE REMAINDER DIVISOR
    RET
